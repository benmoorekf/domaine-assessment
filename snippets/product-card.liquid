{% comment %}
  Product Card Snippet
  --------------------
  Renders a product card with:
  - Sale badge (variant-level detection)
  - Primary image with hover secondary image reveal
  - Colour variant swatches with image swap
  - Brand, title, and markdown pricing

  Usage:
    {% render 'product-card', product: product %}

  Expects product variants to have:
  - variant.featured_image         → primary image per colour
  - variant.metafields.custom.hover_image → secondary image per colour
  - variant.metafields.custom.swatch_color → hex value for swatch dot
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

{% comment %} Variant-level sale detection — never rely on product-level compare_at_price
  as only some variants may be on sale. {% endcomment %}
{% assign on_sale = false %}
{% if current_variant.compare_at_price > current_variant.price %}
  {% assign on_sale = true %}
{% endif %}

<product-card
  class="block bg-white border border-gray-200 rounded-2xl p-4 cursor-pointer"
  data-product-id="{{ product.id }}"
>

  {% comment %} ===================== IMAGE AREA ===================== {% endcomment %}
  <div class="relative bg-white rounded-xl overflow-hidden mb-4" style="aspect-ratio: 4/5;">

    {% comment %} Sale badge — absolute overlay, top-left {% endcomment %}
    {% if on_sale %}
      <span
        class="absolute top-3 left-3 z-10 bg-white border-2 border-red-600
               text-red-600 text-sm font-medium px-3 py-1 rounded-full leading-none"
        aria-label="On sale"
      >
        On Sale!
      </span>
    {% endif %}

    {% comment %} Primary image — shown by default {% endcomment %}
    {% if current_variant.featured_image %}
      <img
        data-primary-image
        src="{{ current_variant.featured_image | image_url: width: 600 }}"
        srcset="
          {{ current_variant.featured_image | image_url: width: 400 }} 400w,
          {{ current_variant.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 640px) 100vw, 400px"
        alt="{{ current_variant.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-contain object-bottom
               transition-opacity duration-300"
        height=""
        width=""
      >
    {% endif %}

    {% comment %} Secondary image — preloaded but hidden. Fades in on card hover.
      object-bottom anchors to the shirt rather than the model's head on square crops. {% endcomment %}
    {% if current_variant.metafields.custom.hover_image %}
      <img
        data-hover-image
        src="{{ current_variant.metafields.custom.hover_image | image_url: width: 600 }}"
        srcset="
          {{ current_variant.metafields.custom.hover_image | image_url: width: 400 }} 400w,
          {{ current_variant.metafields.custom.hover_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 640px) 100vw, 400px"
        alt="{{ product.title | escape }} — alternate view"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-contain object-bottom
               opacity-0 transition-opacity duration-300"
        height=""
        width=""
      >
    {% endif %}

  </div>
  {% comment %} ===================== END IMAGE AREA ===================== {% endcomment %}


  {% comment %} ===================== SWATCHES ===================== {% endcomment %}
  {% comment %} Each swatch button carries primary + hover image URLs as data attributes
    so the JS never needs to make an API call — all data is available at render time. {% endcomment %}
  {% if product.variants.size > 1 %}
    <div class="flex gap-2 mb-3" role="group" aria-label="Colour options">
      {% for variant in product.variants %}
        {% assign is_selected = false %}
        {% if variant.id == current_variant.id %}
          {% assign is_selected = true %}
        {% endif %}

        <button
          class="swatch w-5 h-5 md:w-7 md:h-7 shrink-0 rounded-full border border-transparent
                 focus:outline-none focus:ring-2 focus:ring-offset-2
                 focus:ring-gray-400 transition-shadow duration-150
                 {% if variant.available == false %}opacity-40 cursor-not-allowed{% endif %}"
          data-variant-id="{{ variant.id }}"
          data-primary-src="{{ variant.featured_image | image_url: width: 600 }}"
          data-primary-srcset="{{ variant.featured_image | image_url: width: 400 }} 400w, {{ variant.featured_image | image_url: width: 800 }} 800w"
          data-hover-src="{{ variant.metafields.custom.hover_image | default: product.images[0] | image_url: width: 600 }}"
          data-hover-srcset="{{ variant.metafields.custom.hover_image | default: product.images[0] | image_url: width: 400 }} 400w, {{ variant.metafields.custom.hover_image | default: product.images[0] | image_url: width: 800 }} 800w"
          data-price="{{ variant.price }}"
          data-compare-price="{{ variant.compare_at_price }}"
          data-available="{{ variant.available }}"
          style="background-color: {{ variant.metafields.custom.swatch_color | default: '#cccccc' }}"
          aria-label="Select {{ variant.title }}"
          aria-pressed="{{ is_selected }}"
          {% if variant.available == false %}
            disabled
            aria-disabled="true"
          {% endif %}
        ></button>
      {% endfor %}
    </div>
  {% endif %}
  {% comment %} ===================== END SWATCHES ===================== {% endcomment %}


  {% comment %} ===================== PRODUCT INFO ===================== {% endcomment %}
  <div class="product-card__info">

    {% comment %} Brand name {% endcomment %}
    {% if product.vendor != blank %}
      <p class="text-sm text-gray-500 mb-0.5">{{ product.vendor }}</p>
    {% endif %}

    {% comment %} Product title — links to PDP {% endcomment %}
    <h2 class="text-xl font-bold text-blue-700 mb-1 leading-tight">
      <a
        href="{{ product.url }}"
        class="hover:underline focus:outline-none focus:underline"
        tabindex="-1"
      >
        {{ product.title }}
      </a>
    </h2>

    {% comment %} Pricing — shows markdown layout when on sale {% endcomment %}
    <div class="flex items-baseline gap-2" data-price-block>
      {% if on_sale %}
        <span
          class="text-base text-gray-400 line-through"
          aria-label="Original price"
        >
          {{ current_variant.compare_at_price | money }}
        </span>
        <span
          class="text-base font-medium text-red-500"
          aria-label="Sale price"
        >
          {{ current_variant.price | money }}
        </span>
      {% else %}
        <span
          class="text-base font-medium text-gray-900"
          aria-label="Price"
        >
          {{ current_variant.price | money }}
        </span>
      {% endif %}
    </div>

  </div>
  {% comment %} ===================== END PRODUCT INFO ===================== {% endcomment %}

</product-card>
